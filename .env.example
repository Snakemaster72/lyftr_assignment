# Copy to .env and fill in real values. Never commit .env.

# --- Required by the spec -----------------------------------------------------
# Comma-separated key pool, at least 2 keys. Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=gsk_replace_me_1,gsk_replace_me_2
# SQLite location. Four slashes = absolute path (/data is the Docker volume).
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins allowed to call the API (the frontend URL).
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure header (failover demo). Must be true on the deployed backend.
ENABLE_FAILURE_SIMULATION=true

# --- LLM ----------------------------------------------------------------------
# LiteLLM model string used for every key.
LLM_MODEL=groq/openai/gpt-oss-20b
# Optional: one model per key (comma-separated, same order as LLM_API_KEYS) to mix providers.
LLM_MODELS=
# Optional: override the provider base URL (used by tests to point at a fake server).
LLM_API_BASE=
# Per-call timeout, so a hanging key fails over instead of stalling the request.
LLM_TIMEOUT_SECONDS=30
# Used when a session never sent a system_prompt.
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
# Send only the most recent N stored messages to the LLM (0 = whole history).
HISTORY_MAX_MESSAGES=0

# --- Response cache -----------------------------------------------------------
# local = in-process memory; disk = files under CACHE_DIR (survives restarts when on the volume).
CACHE_TYPE=local
CACHE_DIR=/data/llm-cache
CACHE_TTL_SECONDS=86400
CACHE_MAX_ITEMS=1000

# --- Misc ---------------------------------------------------------------------
# true exposes /docs, /redoc and /openapi.json (off by default: the contract has exactly 3 paths).
ENABLE_DOCS=false
LOG_LEVEL=INFO

# --- Frontend (build time; the container can also override at runtime) --------
VITE_API_BASE_URL=http://localhost:8000
